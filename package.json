{
  "name": "mybridge",
  "version": "0.3.0",
  "private": true,
  "main": "src/electron-main.js",
  "author": "MyBridge",
  "description": "A lightweight Windows to Mac LAN folder sync tool.",
  "type": "module",
  "scripts": {
    "start": "node src/cli.js",
    "test": "node scripts/run-tests.js",
    "desktop": "electron .",
    "desktop:mac": "electron .",
    "dist": "electron-builder",
    "build:win:x64": "electron-builder --win --x64 --publish never",
    "build:mac:arm64": "electron-builder --mac --arm64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mybridge.app",
    "productName": "MyBridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "defaultArch": "arm64",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "artifactName": "MyBridge-${version}-arm64.${ext}"
    },
    "win": {
      "defaultArch": "x64",
      "artifactName": "MyBridge-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "MyBridge-${version}-x64-Setup.${ext}"
    }
  }
}
